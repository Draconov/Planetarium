{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Planetarium",
  "version": "1.1.0",
  "identifier": "com.draconov.planetarium",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:8080",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist/web",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Planetarium",
        "width": 960,
        "height": 540,
        "minWidth": 480,
        "minHeight": 270,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
